<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>415fdbb4-2f1b-4002-9f05-e3951962ccec</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>App\main.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.$(ProjectDir)</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>ForeFlight-ContentPack-Studio</Name>
    <RootNamespace>ForeFlight-ContentPack-Studio</RootNamespace>
    <TestFramework>Pytest</TestFramework>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
    <IsWindowsApplication>False</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="App\" />
    <Folder Include="App\tests\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App\cover_metadata.py" />
    <Compile Include="App\dependency_setup.py" />
    <Compile Include="App\flip_parser.py" />
    <Compile Include="App\main.py" />
    <Compile Include="App\opencv_roi.py" />
    <Compile Include="App\orientation_turn.py" />
    <Compile Include="App\pdf_splitter.py" />
    <Compile Include="App\planview_roi.py" />
    <Compile Include="App\roi_orientation_pipeline.py" />
    <Compile Include="App\tests\test_pdf_splitter.py" />
    <Compile Include="App\tests\test_orientation_turn_features.py" />
    <Compile Include="App\tests\test_roi_orientation_pipeline.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Version>3.14</Version>
      <Description>.venv (Python 3.14.6)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>